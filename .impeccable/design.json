 "narrative": {
  "northStar": "La sala de proyeccion",
  "overview": "La pagina es una sala a oscuras y el trabajo es lo unico iluminado. El fondo casi negro no es un tema oscuro de interfaz: es la penumbra que hace que la pared de piezas brille. La interfaz se retira y deja que doce marcas reales ocupen la pared en placas contiguas.",
  "keyCharacteristics": [
   "Dos mundos de color con un solo interruptor de clase, no dos sistemas.",
   "Una sola familia tipografica; la jerarquia la hace el tamano y el tracking.",
   "Cero sombras: la profundidad es tonal mas filetes.",
   "El muro no lleva leyendas, ni bordes, ni radio.",
   "El violeta es de las acciones, no del ambiente."
  ],
  "rules": [
   {
    "name": "La regla del interruptor",
    "body": "Los dos mundos comparten tokens; solo cambian sus valores dentro de .section--light.",
    "section": "colors"
   },
   {
    "name": "La regla del violeta escaso",
    "body": "El violeta no decora: senala lo pulsable.",
    "section": "colors"
   },
   {
    "name": "La regla de una sola voz",
    "body": "Ninguna seccion introduce una familia nueva.",
    "section": "typography"
   },
   {
    "name": "La regla plana",
    "body": "Una superficie en reposo no proyecta sombra.",
    "section": "elevation"
   }
  ],
  "dos": [
   "Do mantener el violeta por debajo del 10 % de cualquier pantalla.",
   "Do usar --muted para el texto secundario y comprobar 7:1 en los dos mundos.",
   "Do separar secciones con aire y con el cambio de mundo, nunca con una linea a todo el ancho.",
   "Do mantener el retrato en blanco y negro."
  ],
  "donts": [
   "Don't poner leyendas, nombres ni anos bajo las imagenes del muro.",
   "Don't anadir sombras, halos o desenfoques decorativos.",
   "Don't introducir una segunda familia tipografica.",
   "Don't usar el violeta como fondo de seccion ni como degradado.",
   "Don't cambiar el radio de las placas del muro."
  ]
 }
}